{
    "name": "GitHubOTA",
    "version": "0.1.0",
    "description": "Библиотека автономного OTA обновления для ESP32/ESP8266: проверяет релизы GitHub на наличие новой версии, загружает ее с проверкой MD5 и устанавливает с автоматическим откатом при ошибках на поддерживаемых платформах",
    "keywords": ["ota", "github", "update", "firmware", "esp32", "esp8266"],
    "repository": {
        "type": "git",
        "url": "https://github.com/Al-Zhilin/GitHubOTA.git"
    },
    "authors": [
        {
            "name": "Al-Zhilin",
            "email": "alekseyzh5@gmail.com",
            "maintainer": true
        }
    ],
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": ["espressif32", "espressif8266"],
    "dependencies": [
        { "name": "WiFi", "platforms": "espressif32" },
        { "name": "HTTPClient", "platforms": "espressif32" },
        { "name": "ESP8266WiFi", "platforms": "espressif8266" },
        { "name": "ESP8266HTTPClient", "platforms": "espressif8266" },
        { "name": "EEPROM" }
    ]
}
