/*
    - Пример автоматической проверки обновлений и установки, при их наличии

    С помощью тикера в loop() библиотека проверяет наличие обновления в фоне, через указанный таймаут
    А благодаря AutoInstall режиму работы при наличии обновления оно само установится, либо вернет код возрата - см. ниже
*/

#include <Arduino.h>
#include <GitHubOTA.h>


#if defined(ESP32)
    #include <WiFi.h>
    #include <WiFiClientSecure.h>
    WiFiClientSecure client;                                 // клиент для защищенного соединения
#elif defined(ESP8266)
    #include <ESP8266WiFi.h>
    #include <WiFiClientSecureBearSSL.h>
    BearSSL::WiFiClientSecure client;                        // клиент для защищенного соединения
#endif

#define WiFi_SSID "ваше имя сети"                            // ssid (имя) WiFI сети
#define WiFi_PASS "ваш пароль от сети"                       // пароль от WiFi сети

GitHubOTA updater;                                           // объект библиотеки

void setup() {
    Serial.begin(9600);

    Serial.printf("Подключение к %s\n", WiFi_SSID);
    WiFi.begin(WiFi_SSID, WiFi_PASS);                        // подключаемся к сети
    while (WiFi.status() != WL_CONNECTED) {                  // с ожиданием
        delay(50);
        Serial.print(".");
    }
    Serial.println("Подключено к сети WiFi!");

    client.setInsecure();                                    // для тестов отключим проверку сертификата

    GitHubOTA::Config cfg;                                   // создаем конфиг - профиль настроек работы
    cfg.repoOwner = "Al-Zhilin";                             // владелец репозитория, в котором ловим обновления
    cfg.repoName = "GitHubOTA-TestBed";                      // имя репозитория, в котором будут мониториться релизы
    cfg.currentVersion = "v0.0.1";                           // намеренно устаревшая версия прошивки, чтобы проверка выдала наличие обновления
    cfg.checkIntervalMs = 120000;                            // автопроверка наличия обновления в фоне, раз в 2 минуты. Первый запуск - при первом вызове тикера (handle()), все следующие - по таймеру
    cfg.policy = GitHubOTA::Config::Policy::AutoInstall;     // режим работы: автоустановка обновлений при наличии

    updater.begin(cfg, client);                              // передаем конфиг настроек и клиент защищенного соединения
}

void loop() {
    GitHubOTA::Status stat;
    stat = updater.handle();                                 // фоновый тикер: по настроенному в конфиге таймеру проверяет наличие обновлений и устанавливает их, если настроен соответствующий режим работы

    /*
    Status::SUCCESS здесь означает ОДНО ИЗ ДВУХ, а не только "проверили — обновлений нет":
    - ещё не наступило время очередной проверки (checkIntervalMs не истёк) — это
      самый частый случай, handle() почти всегда просто выходит сразу;
    - проверка состоялась, но обновлений не нашлось.

    Если обновление нашлось И успешно установилось (Policy::AutoInstall) — сюда
    выполнение вообще не дойдёт: внутри update() происходит ESP.restart() ДО
    возврата из функции. Поэтому "успешно обновились" — это состояние, которое
    в принципе нельзя поймать проверкой ниже, оно и не должно быть тут видно.

    Всё, что не SUCCESS — это ошибка (сети, разбора JSON, отсутствия нужного
    ассета в релизе, несовпадения MD5 и т.п.), либо самой проверки, либо
    попытки установки, которая не дошла до перезагрузки.
    */

    if (stat != GitHubOTA::Status::SUCCESS) {
        Serial.printf("Обнаружены следующие ошибки handle(): %d", stat);
    }
}